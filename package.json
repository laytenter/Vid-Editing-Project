{
  "name": "vid-editing-project",
  "productName": "Vid Editing",
  "private": true,
  "version": "1.0.0",
  "description": "Local video and audio editing with captions, FFmpeg and Whisper",
  "repository": {
    "type": "git",
    "url": "https://github.com/laytenter/Vid-Editing-Project.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.js && node scripts/check-browser-script-scope.js",
    "test": "tsc -p tsconfig.tests.json && node scripts/run-tests.js",
    "test:native": "npm test && node .tmp-test/tests/audio-processing.native.test.js",
    "test:electron": "npm run build && node scripts/run-electron-smoke.js",
    "start": "npm run build && set ELECTRON_RUN_AS_NODE=&& .\\node_modules\\.bin\\electron.cmd ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-store": "8.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "electron": "43.4.1",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "electron@43.4.1": true
  }
}
